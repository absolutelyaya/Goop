{
  "schemaVersion": 1,
  "id": "goop",
  "version": "${version}",
  "name": "Goop Technology",
  "description": "Adds Splatter Particle Effects for Blood, Slime or other cool VFX",
  "authors": [
    "Absolutelyaya"
  ],
  "contact": {
    "issues": "https://github.com/absolutelyaya/Goop/issues",
    "repo": "https://github.com/absolutelyaya/Goop",
    "homepage": "https://absolutelyaya.cool"
  },
  "license": "MIT",
  "icon": "assets/goop/icon.png",
  "environment": "*",
  "accessWidener": "goop.accesswidener",
  "entrypoints": {
    "client": [
      "absolutelyaya.goop.client.GoopClient"
    ],
    "main": [
      "absolutelyaya.goop.Goop"
    ],
    "modmenu": [
      "absolutelyaya.goop.client.ModMenu"
    ]
  },
  "mixins": [
    "goop.mixins.json",
    {
      "config": "goop.client.mixins.json",
      "environment": "client"
    }
  ],
  "depends": {
    "fabricloader": ">=${loader_version}",
    "fabric": "*",
    "minecraft": "${minecraft_version}"
  },
  "custom": {
    "modmenu": {
      "links": {
        "Fund yayas world domination": "https://ko-fi.com/absolutelyaya"
      },
      "update_checker": true
    }
  }
}
